'use strict';
const express=require('express'),helmet=require('helmet'),rateLimit=require('express-rate-limit'),bcrypt=require('bcryptjs'),Database=require('better-sqlite3'),crypto=require('crypto'),path=require('path'),fs=require('fs');
try{const env=fs.readFileSync(path.join(__dirname,'..','.env'),'utf8');for(const line of env.split(/\r?\n/)){const m=line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$/);if(m&&process.env[m[1]]===undefined)process.env[m[1]]=m[2].replace(/^['"]|['"]$/g,'');}}catch{}
const app=express(),port=Number(process.env.PORT||3000),secret=process.env.SESSION_SECRET||'';
if(secret.length<32){console.error('SESSION_SECRET must be set to >=32 characters; configure .env');process.exit(1);}
app.disable('x-powered-by');app.use(helmet({contentSecurityPolicy:false}));app.use(express.json({limit:'256kb'}));
const db=new Database(path.join(__dirname,'tikguard.db'));db.pragma('journal_mode=WAL');db.pragma('foreign_keys=ON');
db.exec(`CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,username TEXT NOT NULL UNIQUE,password_hash TEXT NOT NULL,role TEXT NOT NULL CHECK(role IN ('admin','editor','reviewer','viewer')),created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS sessions(token_hash TEXT PRIMARY KEY,user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,expires_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS content_items(id INTEGER PRIMARY KEY AUTOINCREMENT,title TEXT NOT NULL,platform TEXT NOT NULL,brief TEXT NOT NULL DEFAULT '',planned_date TEXT,status TEXT NOT NULL CHECK(status IN ('idea','ready','published')),created_by INTEGER REFERENCES users(id),created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS tasks(id INTEGER PRIMARY KEY AUTOINCREMENT,title TEXT NOT NULL,description TEXT NOT NULL DEFAULT '',assigned_user INTEGER REFERENCES users(id),due_date TEXT,priority TEXT NOT NULL DEFAULT 'normal' CHECK(priority IN ('low','normal','high')),status TEXT NOT NULL DEFAULT 'todo' CHECK(status IN ('todo','doing','review','done','rework')),created_by INTEGER REFERENCES users(id),created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS audit_log(id INTEGER PRIMARY KEY AUTOINCREMENT,actor_user_id INTEGER REFERENCES users(id),event TEXT NOT NULL,details TEXT NOT NULL DEFAULT '',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE INDEX IF NOT EXISTS idx_session_expiry ON sessions(expires_at);CREATE INDEX IF NOT EXISTS idx_content_date ON content_items(planned_date);CREATE INDEX IF NOT EXISTS idx_tasks_due ON tasks(due_date);`);
const q={userByName:db.prepare('SELECT * FROM users WHERE username=?'),userById:db.prepare('SELECT id,username,role,created_at FROM users WHERE id=?'),session:db.prepare('SELECT s.user_id,s.expires_at,u.username,u.role FROM sessions s JOIN users u ON u.id=s.user_id WHERE token_hash=?'),createSession:db.prepare('INSERT INTO sessions(token_hash,user_id,expires_at) VALUES(?,?,?)'),removeSession:db.prepare('DELETE FROM sessions WHERE token_hash=?'),audit:db.prepare('INSERT INTO audit_log(actor_user_id,event,details) VALUES(?,?,?)')};
const loginLimit=rateLimit({windowMs:15*60*1000,limit:8,standardHeaders:true,legacyHeaders:false,message:{error:'محاولات كثيرة. انتظر ثم حاول.'}}),hashToken=t=>crypto.createHmac('sha256',secret).update(t).digest('hex');
function text(v,n=1000){return typeof v==='string'?v.trim().slice(0,n):'';}function date(v){if(v==null||v==='')return null;if(typeof v!=='string'||!/^(\d{4})-(\d{2})-(\d{2})$/.test(v))return false;const [y,m,d]=v.split('-').map(Number);const dt=new Date(Date.UTC(y,m-1,d));return dt.getUTCFullYear()===y&&dt.getUTCMonth()===m-1&&dt.getUTCDate()===d?v:false;}
function bearer(req){const h=req.headers.authorization||'';return h.startsWith('Bearer ')?h.slice(7):'';}function auth(req,res,next){const token=bearer(req);if(!token)return res.status(401).json({error:'تسجيل الدخول مطلوب'});const h=hashToken(token);db.prepare('DELETE FROM sessions WHERE expires_at < ?').run(Date.now());const s=q.session.get(h);if(!s||s.expires_at<Date.now()){q.removeSession.run(h);return res.status(401).json({error:'الجلسة غير صالحة'});}req.user={id:s.user_id,username:s.username,role:s.role};req.tokenHash=h;next();}
function roles(...r){return(req,res,next)=>r.includes(req.user.role)?next():res.status(403).json({error:'لا توجد صلاحية'});}function log(req,event,detail=''){q.audit.run(req.user?.id||null,event,text(detail,500));}function validDateInput(raw){return raw==null||raw===''?null:date(raw);}
app.get('/api/health',(req,res)=>res.json({ok:true,service:'TikGuard Hub API',version:14}));
app.post('/api/auth/login',loginLimit,async(req,res)=>{const username=text(req.body?.username,60),password=typeof req.body?.password==='string'?req.body.password:'';const u=q.userByName.get(username);if(!u||!await bcrypt.compare(password,u.password_hash))return res.status(401).json({error:'بيانات الدخول غير صحيحة'});const token=crypto.randomBytes(32).toString('hex'),expires=Date.now()+8*60*60*1000;q.createSession.run(hashToken(token),u.id,expires);q.audit.run(u.id,'login','');res.json({token,expiresAt:expires,user:{id:u.id,username:u.username,role:u.role}});});
app.post('/api/auth/logout',auth,(req,res)=>{q.removeSession.run(req.tokenHash);log(req,'logout');res.json({ok:true});});app.get('/api/auth/me',auth,(req,res)=>res.json({user:req.user}));
app.get('/api/users',auth,roles('admin'),(_req,res)=>res.json(db.prepare('SELECT id,username,role,created_at FROM users ORDER BY id').all()));
app.post('/api/users',auth,roles('admin'),async(req,res)=>{const username=text(req.body?.username,60),password=typeof req.body?.password==='string'?req.body.password:'',role=req.body?.role;if(!/^[A-Za-z0-9._-]{3,60}$/.test(username))return res.status(400).json({error:'اسم المستخدم غير صالح'});if(password.length<12)return res.status(400).json({error:'كلمة المرور يجب أن تكون 12 حرفًا على الأقل'});if(!['admin','editor','reviewer','viewer'].includes(role))return res.status(400).json({error:'الدور غير صالح'});try{const ph=await bcrypt.hash(password,12),r=db.prepare('INSERT INTO users(username,password_hash,role) VALUES(?,?,?)').run(username,ph,role);log(req,'user_create',username);res.status(201).json(q.userById.get(r.lastInsertRowid));}catch(err){if(String(err).includes('UNIQUE'))return res.status(409).json({error:'اسم المستخدم مستخدم'});res.status(500).json({error:'تعذر إنشاء الحساب'});}});
app.get('/api/content',auth,(_req,res)=>res.json(db.prepare('SELECT * FROM content_items ORDER BY planned_date,id').all()));
app.post('/api/content',auth,roles('admin','editor'),(req,res)=>{const title=text(req.body?.title,120),platform=text(req.body?.platform,40),brief=text(req.body?.brief,2000),planned=validDateInput(req.body?.planned_date),status=req.body?.status||'idea';if(!title||!platform)return res.status(400).json({error:'العنوان والمنصة مطلوبان'});if(req.body?.planned_date&&!planned)return res.status(400).json({error:'تاريخ غير صحيح'});if(!['idea','ready','published'].includes(status))return res.status(400).json({error:'حالة غير صالحة'});const r=db.prepare('INSERT INTO content_items(title,platform,brief,planned_date,status,created_by) VALUES(?,?,?,?,?,?)').run(title,platform,brief,planned,status,req.user.id);log(req,'content_create',title);res.status(201).json(db.prepare('SELECT * FROM content_items WHERE id=?').get(r.lastInsertRowid));});
app.patch('/api/content/:id',auth,(req,res)=>{const id=Number(req.params.id),old=db.prepare('SELECT * FROM content_items WHERE id=?').get(id);if(!old)return res.status(404).json({error:'غير موجود'});if(req.user.role==='reviewer'){const status=req.body?.status;if(Object.keys(req.body||{}).some(k=>k!=='status')||!['idea','ready'].includes(status))return res.status(403).json({error:'المراجع يغير الحالة إلى فكرة أو جاهز فقط، ولا يملك صلاحية النشر'});db.prepare('UPDATE content_items SET status=?,updated_at=CURRENT_TIMESTAMP WHERE id=?').run(status,id);log(req,'content_review',`${id}:${status}`);return res.json(db.prepare('SELECT * FROM content_items WHERE id=?').get(id));}if(!['admin','editor'].includes(req.user.role))return res.status(403).json({error:'لا توجد صلاحية'});const title=req.body?.title===undefined?old.title:text(req.body.title,120),platform=req.body?.platform===undefined?old.platform:text(req.body.platform,40),brief=req.body?.brief===undefined?old.brief:text(req.body.brief,2000),planned=req.body?.planned_date===undefined?old.planned_date:validDateInput(req.body.planned_date),status=req.body?.status===undefined?old.status:req.body.status;if(!title||!platform)return res.status(400).json({error:'العنوان والمنصة مطلوبان'});if(req.body?.planned_date!==undefined&&req.body.planned_date!==null&&!planned)return res.status(400).json({error:'تاريخ غير صحيح'});if(!['idea','ready','published'].includes(status))return res.status(400).json({error:'حالة غير صالحة'});db.prepare('UPDATE content_items SET title=?,platform=?,brief=?,planned_date=?,status=?,updated_at=CURRENT_TIMESTAMP WHERE id=?').run(title,platform,brief,planned,status,id);log(req,'content_update',`id=${id}`);res.json(db.prepare('SELECT * FROM content_items WHERE id=?').get(id));});
app.delete('/api/content/:id',auth,roles('admin','editor'),(req,res)=>{const r=db.prepare('DELETE FROM content_items WHERE id=?').run(Number(req.params.id));if(!r.changes)return res.status(404).json({error:'غير موجود'});log(req,'content_delete',req.params.id);res.json({ok:true});});
app.get('/api/tasks',auth,(_req,res)=>res.json(db.prepare('SELECT * FROM tasks ORDER BY due_date,id').all()));app.post('/api/tasks',auth,roles('admin','editor'),(req,res)=>{const title=text(req.body?.title,120),description=text(req.body?.description,2000),due=validDateInput(req.body?.due_date),priority=req.body?.priority||'normal',assigned=req.body?.assigned_user||null;if(!title)return res.status(400).json({error:'عنوان المهمة مطلوب'});if(req.body?.due_date&&!due)return res.status(400).json({error:'تاريخ غير صحيح'});if(!['low','normal','high'].includes(priority))return res.status(400).json({error:'الأولوية غير صالحة'});if(assigned&&!q.userById.get(assigned))return res.status(400).json({error:'المستخدم غير موجود'});const r=db.prepare('INSERT INTO tasks(title,description,assigned_user,due_date,priority,created_by) VALUES(?,?,?,?,?,?)').run(title,description,assigned,due,priority,req.user.id);log(req,'task_create',title);res.status(201).json(db.prepare('SELECT * FROM tasks WHERE id=?').get(r.lastInsertRowid));});
app.patch('/api/tasks/:id/status',auth,roles('admin','editor','reviewer'),(req,res)=>{const task=db.prepare('SELECT * FROM tasks WHERE id=?').get(Number(req.params.id));if(!task)return res.status(404).json({error:'المهمة غير موجودة'});const status=req.body?.status;if(!['todo','doing','review','done','rework'].includes(status))return res.status(400).json({error:'حالة غير صالحة'});db.prepare('UPDATE tasks SET status=?,updated_at=CURRENT_TIMESTAMP WHERE id=?').run(status,task.id);log(req,'task_status',`${task.id}:${status}`);res.json(db.prepare('SELECT * FROM tasks WHERE id=?').get(task.id));});
app.get('/api/reports/summary',auth,(req,res)=>{const tasks=db.prepare('SELECT status,count(*) count FROM tasks GROUP BY status').all(),content=db.prepare('SELECT status,count(*) count FROM content_items GROUP BY status').all();res.json({tasks,content,totals:{tasks:db.prepare('SELECT count(*) n FROM tasks').get().n,content:db.prepare('SELECT count(*) n FROM content_items').get().n,users:db.prepare('SELECT count(*) n FROM users').get().n}});});app.get('/api/audit',auth,roles('admin'),(_req,res)=>res.json(db.prepare('SELECT a.id,a.event,a.details,a.created_at,u.username FROM audit_log a LEFT JOIN users u ON u.id=a.actor_user_id ORDER BY a.id DESC LIMIT 250').all()));
app.use('/',express.static(path.join(__dirname,'..','public')));app.use((req,res)=>res.status(404).json({error:'المسار غير موجود'}));app.use((err,_req,res,_next)=>{console.error('Unhandled:',err.message);res.status(500).json({error:'خطأ داخلي'});});
const server=app.listen(port,()=>console.log(`TikGuard Hub V14 listening on port ${port}`));process.on('SIGINT',()=>{server.close(()=>{db.close();process.exit(0);});});
